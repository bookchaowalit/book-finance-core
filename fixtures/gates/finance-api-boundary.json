  "consumers": [
    {
      "name": "finance-v1-shadow",
      "kind": "binary (stdin JSON -> parity line)",
      "path": "src/bin/finance-v1-shadow.rs",
      "uses": [
        "book_finance_core::shadow::FinanceV1Summary",
        "book_finance_core::shadow::FinanceV1Summary::from_json",
        "book_finance_core::shadow::FinanceV1Summary::parity"
      ]
    },
    {
      "name": "finance-command-pilot",
      "kind": "binary (opt-in flag, stdin envelope -> preview JSON)",
      "path": "src/bin/finance-command-pilot.rs",
      "uses": [
        "book_finance_core::command::CommandEnvelope",
        "book_finance_core::command::CommandEnvelope::from_json",
        "book_finance_core::command::CommandExecutor",
        "book_finance_core::command::CommandExecutor::execute",
        "book_finance_core::command::FINANCE_CORE_COMMANDS_ENABLED_ENV",
        "book_finance_core::command::feature_flag_enabled"
      ]
    },
    {
      "name": "solo-empire task test:finance-shadow",
      "kind": "external loopback harness piping a finance.v1 summary into the finance-v1-shadow binary",
      "path": null,
      "uses": [
        "book_finance_core::shadow::FinanceV1Summary::from_json"
      ]
    },
    {
      "name": "solo-empire task test:finance-command",
      "kind": "external harness piping a command envelope into the finance-command-pilot binary",
      "path": null,
      "uses": [
        "book_finance_core::command::CommandEnvelope::from_json",
        "book_finance_core::command::CommandExecutor::execute"
      ]
    },
    {
      "name": "book-finance-api (proposed, not created)",
      "kind": "future facade validating the summary it serves (library dependency if Rust, otherwise the stdin binary)",
      "path": null,
      "uses": [
        "book_finance_core::shadow::FinanceV1Summary::from_json",
        "book_finance_core::shadow::FinanceV1Summary::parity",
        "book_finance_core::Money::parse",
        "book_finance_core::Money::to_decimal_string",
